meta {
  name: POST Political debate
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/caasra
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(test-inputs/political_debate.json)
}

tests {
  const expectedData = require('./test-expected/political_debate_actual.json');

  test("Response status should be 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response should match expected value", function () {
    const receivedData = res.getBody();
    expect(receivedData).to.deep.equal(expectedData);
  });
}
